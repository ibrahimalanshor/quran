---
import { getCollection } from "astro:content";
import { Icon } from 'astro-icon/components'
import Default from '../components/layouts/Default.astro'
import BaseLink from '../components/base/BaseLink.astro'
import BaseContainer from '../components/base/BaseContainer.astro'

const chapters = await getCollection('chapters')
---

{false && <Default>
  <h1 class="text-center font-bold text-2xl md:text-3xl xl:text-4xl">Baca Al-Quran Online</h1>
  <input type="search" placeholder="Cari nama surat" class="w-full rounded-md h-11 border-neutral-300 placeholder-neutral-400 focus:border-green-600 focus:ring-2 focus:ring-green-600" />
  <ol class="grid gap-y-2 md:grid-cols-2 md:gap-x-6 lg:grid-cols-3 lg:gap-x-8">
    {chapters.map(chapter => <li data-chapter={chapter.data.latin} class="flex justify-between">
      <BaseLink href={`chapters/${chapter.data.slug}`} class="flex gap-1 font-medium">
        <span>{chapter.id}.</span>
        <span>{chapter.data.latin}</span>
      </BaseLink>
      <BaseLink href={`chapters/${chapter.data.slug}`} dir="rtl" class="text-xl font-bold self-center" color="primary">{chapter.data.name}</BaseLink>
    </li>)}
  </ol>
</Default>}

<Default>
  <header class="bg-emerald-600 text-white h-52 flex flex-col items-center justify-center text-center shadow-lg">
    <div class="px-4 w-full space-y-6">
      <h1 class="font-bold text-4xl">Al-Quran Online</h1>
      <div class="max-w-lg mx-auto relative">
        <input type="search" placeholder="Cari nama surah" class="w-full h-12 px-5 rounded-full border-0 placeholder-gray-400 text-gray-700 shadow-md transition focus:outline-0 focus:ring-4 focus:ring-emerald-400" />
        <buttpn class="absolute top-1.5 right-2 bg-emerald-500 text-white h-9 w-9 flex items-center justify-center rounded-full">
          <Icon name="tabler:search" class="size-5" />
        </buttpn>
      </div>
    </div>
  </header>

  <BaseContainer tag="main" class="py-10 space-y-6">
    <h2 class="font-semibold text-xl border-l-4 border-emerald-500 pl-3">Daftar Surah</h2>

    <ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {chapters.map(chapter => <li class="bg-white rounded-xl shadow-sm border border-gray-50 p-5 flex items-center justify-between hover:shadow-md hover:border-emerald-500">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 flex items-center justify-center bg-emerald-50 font-bold text-emerald-600 rounded-md">{chapter.id}</div>
          <div>
            <h3 class="font-bold">{chapter.data.latin}</h3>
            <p class="text-xs uppercase text-gray-500 tracking-wider">{chapter.data.verses} ayat</p>
          </div>
        </div>

        <p dir="rtl" class="text-emerald-700 text-2xl font-bold">{chapter.data.name}</p>
      </li>)}
    </ol>
  </BaseContainer>
</Default>

<script>
  const searchInput = document.querySelector('main input') as HTMLInputElement
  const chapters = document.querySelectorAll('[data-chapter]')

  searchInput.addEventListener('input', () => {
    chapters.forEach(chapter => {
      if ((chapter as HTMLDivElement).dataset.chapter!.toLowerCase().includes(searchInput!.value.toLowerCase())) {
        chapter.classList.remove('hidden')
      } else {
        chapter.classList.add('hidden')
      }
    }) 
  })
</script>
