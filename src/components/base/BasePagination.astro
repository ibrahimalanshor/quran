---
import BaseCard from './BaseCard.astro'
import { Icon } from 'astro-icon/components'

const base = import.meta.env.BASE_URL
const { prevUrl, prevName, nextUrl, nextName, class: classList = '' } = Astro.props
---

<nav class={`flex items-center ${!prevUrl ? 'justify-end' : 'justify-between'} ${classList}`}>
  {prevUrl && <a href={`${base}/${prevUrl}`} class="flex items-center gap-2 text-accent font-semibold hover:underline">
    <Icon name="tabler:arrow-left" class="size-5" />
    <span>{prevName}</span>
  </a>}
  {nextUrl && <a href={`${base}/${nextUrl}`} class="flex items-center gap-2 text-accent font-semibold hover:underline">
    <span>{nextName}</span>
    <Icon name="tabler:arrow-right" class="size-5" />
  </a>}
</nav>
