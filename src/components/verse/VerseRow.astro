---
import { Icon } from "astro-icon/components"
import BaseCard from "../base/BaseCard.astro"

const { verse } = Astro.props

function toArabicNum(str: string) : string {
  const arabicNum = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩']

  return str.replace(/\d/gi, d => arabicNum[d])
}
---

<BaseCard id={verse.data.verse} class="p-6 rounded-2xl space-y-4">
  <p dir="rtl" class="text-2xl sm:text-3xl leading-loose">
    <span class="verse-text">{verse.data.text}</span> 
    <span class="mx-2 text-3xl lg:text-4xl text-amber-700 font-bold">{toArabicNum(`${verse.data.verse}`)}</span>
  </p>
  <div class="space-y-2">
    <p class="leading-relaxed text-emerald-700">
      {verse.data.latin}
    </p>
    <p class="leading-relaxed text-gray-700">
      <span class="verse-translation">{verse.data.translation}</span> 
    </p>      
  </div>
  <div class="border-t border-gray-100 pt-4 flex gap-4 justify-end lg:justify-start">
    <button class="cursor-pointer text-gray-500 flex items-center gap-2 text-sm transition hover:text-emerald-600">
      <Icon name="tabler:book" class="size-5" />
      Tafsir
    </button>
    <button class="copy-verse cursor-pointer text-gray-500 flex items-center gap-2 text-sm transition hover:text-emerald-600" data-verse-number={verse.data.verse}>
      <Icon name="tabler:copy" class="size-5" />
      Salin
    </button>
  </div>
</BaseCard>
