---
const { verse } = Astro.props

function toArabicNum(str: string) : string {
  const arabicNum = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩']

  return str.replace(/\d/gi, d => arabicNum[d])
}
---

<div class="py-6 space-y-4">
  <p dir="rtl" class="text-2xl leading-loose lg:text-3xl">
    {verse.data.text}
    <span class="mx-2 text-3xl lg:text-4xl text-yellow-800 font-bold">{toArabicNum(`${verse.data.verse}`)}</span>
  </p>
  <p class="leading-relaxed">
    {verse.data.verse}. 
    {verse.data.translation}
  </p>      
</div>
