---
import { Icon } from "astro-icon/components"
const { verse } = Astro.props

function toArabicNum(str: string) : string {
  const arabicNum = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩']

  return str.replace(/\d/gi, d => arabicNum[d])
}
---

<div id={verse.data.verse} class={`${verse.data.chapter.id === '1' || verse.data.chapter.id === '9' ? 'pt-2 pb-6' : 'py-6'} space-y-4`}>
  <p dir="rtl" class="text-2xl leading-loose lg:text-3xl">
    {verse.data.text}
    <span class="mx-2 text-3xl lg:text-4xl text-yellow-800 font-bold">{toArabicNum(`${verse.data.verse}`)}</span>
  </p>
  <div class="space-y-2">
    <p class="leading-relaxed text-green-700">
      {verse.data.latin}
    </p>
    <p class="leading-relaxed">
      {verse.data.verse}.
      {verse.data.translation}
    </p>      
  </div>
  <div class="flex gap-2 justify-end lg:justify-start">
    <button class="cursor-pointer text-neutral-700 hover:text-green-700" title="Lihat Tafsir">
      <Icon name="tabler:book" class="size-5" />
    </button>
    <button class="cursor-pointer text-neutral-700 hover:text-green-700" title="Salin Ayat">
      <Icon name="tabler:copy" class="size-5" />
    </button>
  </div>
</div>
