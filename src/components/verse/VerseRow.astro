---
import { getEntry } from "astro:content"
import BaseLink from "../base/BaseLink.astro"

const base = import.meta.env.BASE_URL
const { verse, withTafsirButton = true } = Astro.props

function toArabicNum(str: string) : string {
  const arabicNum = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩']

  return str.replace(/\d/gi, d => arabicNum[d])
}
function getFootnoteNumber(str: string) : string | null {
  const found = str.split(/(\d+\))/).filter(Boolean)[0]

  if (!found) {
    return null
  }

  return found.slice(0, found.length - 1)
}
function getFootnoteText(str: string) : string | null {
  return str.split(/(\d+\))/).filter(Boolean)[1]
}

const chapter = await getEntry('chapters', verse.data.chapter.id)
const footnotes: string[] = verse.data.footnotes === null ? [] : verse.data.footnotes.split('\n')

const translations: string[] = verse.data.translation.split(/(\d+\))/)
  .filter(Boolean)
---

<div id={verse.data.verse} class="space-y-4 pb-6 lg:pb-8 border-b-2 border-dashed border-neutral-200">
  <p dir="rtl" class="text-2xl sm:text-3xl leading-loose">
    <span class="verse-text text-neutral-900">{verse.data.text}</span> 
    <span class="mx-2 text-3xl lg:text-4xl text-accent font-bold">{toArabicNum(`${verse.data.verse}`)}</span>
  </p>
  <p class="verse-translation leading-relaxed text-neutral-700">
    {translations.filter(text => !/^\d+\)$/.test(text)).map(text => text)}
  </p>      
  <div class="flex gap-4 justify-end lg:justify-start">
    {withTafsirButton && chapter && <BaseLink tag="a" href={`${base}/${chapter.data.slug}/${verse.data.verse}`} icon="tabler:book">Tafsir</BaseLink>}
    <BaseLink class="copy-verse" data-verse-number={verse.data.verse} icon="tabler:copy">Salin</BaseLink>
  </div>
</div>

<script>
import tippy from 'tippy.js'

const copyVersesBtn = tippy('.copy-verse', {
  trigger: 'manual'
})

const chapterName = (document.querySelector('meta[name=quran-chapter]') as HTMLMetaElement)!.content

copyVersesBtn.forEach(btn => {
  btn.reference.addEventListener('click', async () => {
    const verseNumber = (btn.reference as HTMLButtonElement).dataset.verseNumber as string
    const title = `Q.S ${chapterName}: ${verseNumber}`
    const text = document.getElementById(verseNumber)!
      .querySelector(`.verse-text`)!
      .textContent
    const translation = document.getElementById(verseNumber)!
      .querySelector(`.verse-translation`)!
      .textContent

    const content = `${title}\n${text}\n${translation}`

    await navigator.clipboard.writeText(content)

    btn.setContent('Ayat berhasil disalin!')
    btn.show()
  })
})
</script>
