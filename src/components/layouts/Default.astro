---
import '@fontsource/inter';
import "../../styles/global.css"
import 'tippy.js/dist/tippy.css';
import { Icon } from 'astro-icon/components'
import BaseContainer from '../base/BaseContainer.astro'

const BrandTag = Astro.url.pathname === '/' ? 'h1' : 'p'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body class="text-neutral-900">
    <nav class="h-14 border-b border-neutral-300 flex items-center">
      <BaseContainer class="flex items-center justify-between">
        <button class="md:hidden">
          <Icon name="tabler:menu-2" />
        </button> 
        <BrandTag class="font-bold">Al-Quran Online</BrandTag>
        <button>
          <Icon name="tabler:moon" />
        </button>
      </BaseContainer>
    </nav>
    <BaseContainer tag="main" class="space-y-4 py-8 mx-auto md:py-10 lg:py-12">
      <slot /> 
    </BaseContainer>
	</body>
</html>
