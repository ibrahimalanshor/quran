---
import '@fontsource/inter';
import "../../styles/global.css"
import 'tippy.js/dist/tippy.css';
import { Icon } from 'astro-icon/components'
import BaseContainer from '../base/BaseContainer.astro'

const withNavbar = Astro.url.pathname !== '/'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body class="bg-gray-50 text-gray-800">
    {withNavbar && <nav class="bg-white h-16 shadow-sm border-b border-gray-50">
      <BaseContainer class="h-full flex items-center justify-between">
        <a href="" class="flex items-center gap-2 text-emerald-600 font-bold">
          <Icon name="tabler:arrow-back-up" class="shrink-0 size-5" />
          Kembali
        </a>
        <select class="h-10 border-gray-300 rounded-lg transition focus:outline-0 focus:ring-4 focus:ring-emerald-400/30 focus:border-emerald-400">
          <option selected disabled>Pilih Surah</option>
        </select>
      </BaseContainer>
    </nav>}

    <slot /> 

    <BaseContainer tag="footer" class="space-y-4 py-10">
      <div class="flex items-center justify-center gap-6">
        <a href="/about" class="text-sm font-medium text-gray-600 transition hover:text-emerald-600">Tentang Kami</a>
        <span class="text-gray-300">|</span>
        <a href="http://github.com/ibrahimalanshor/quran-web" class="text-sm font-medium text-gray-600 flex items-center gap-2 transition hover:text-emerald-600">
          <Icon name="tabler:brand-github-filled" />
          Source Code
        </a>
      </div>
      <p class="text-sm text-gray-400 text-center">&copy; 2025 - Al-Quran Online</p>
    </BaseContainer>
	</body>
</html>
