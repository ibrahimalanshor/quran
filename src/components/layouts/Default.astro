---
import '@fontsource/inter';
import "../../styles/global.css"
import 'tippy.js/dist/tippy.css';
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import BaseContainer from '../base/BaseContainer.astro'
import BaseSelect from '../base/BaseSelect.astro'

const withNavbar = Astro.url.pathname !== '/'
const chapters = await getCollection('chapters')

const { backUrl = '/' } = Astro.props
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
    <slot name="meta" />
		<title>Astro</title>
	</head>
	<body class="bg-gray-50 text-gray-800">
    {withNavbar && <nav class="bg-white h-16 shadow-sm border-b border-gray-50">
      <BaseContainer class="h-full flex items-center justify-between">
        <a href={backUrl} class="flex items-center gap-2 text-emerald-600 font-bold hover:text-emerald-700">
          <Icon name="tabler:arrow-back-up" class="shrink-0 size-5" />
          Kembali
        </a>
        <BaseSelect id="chapter-select">
          <option selected disabled>Pilih Surah</option>
          {chapters.map(chapter => <option selected={Astro.url.pathname === `/${chapter.data.slug}`} value={`/${chapter.data.slug}`}>{chapter.data.latin}</option>)}
        </BaseSelect>
      </BaseContainer>
    </nav>}

    <slot /> 

    <BaseContainer tag="footer" class="space-y-4 py-10">
      <div class="flex items-center justify-center gap-6">
        <a href="/about" class="text-sm font-medium text-gray-600 transition hover:text-emerald-600">Tentang Website</a>
        <span class="text-gray-300">|</span>
        <a href="http://github.com/ibrahimalanshor/quran-web" class="text-sm font-medium text-gray-600 flex items-center gap-2 transition hover:text-emerald-600">
          <Icon name="tabler:brand-github-filled" />
          Source Code
        </a>
      </div>
      <p class="text-sm text-gray-400 text-center">&copy; 2025 - Al-Quran Online</p>
    </BaseContainer>

    <script>
      const chapterSelect = document.getElementById('chapter-select')

      chapterSelect?.addEventListener('change', e => {
        window.location.href = (e.target as HTMLSelectElement).value
      })
    </script>
	</body>
</html>
