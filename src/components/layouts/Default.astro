---
import '@fontsource/ibm-plex-sans';
import "../../styles/global.css"
import 'tippy.js/dist/tippy.css';
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import BaseContainer from '../base/BaseContainer.astro'
import BaseSelect from '../base/BaseSelect.astro'
import { SEO } from "astro-seo";

const base = import.meta.env.BASE_URL
const chapters = await getCollection('chapters')

const { title, description, seo, backUrl = base, withNavbar = true, navbarSticky = false, verseLength = null } = Astro.props

const meta = {
  title,
  description,
  image: new URL(base + '/banner.jpg', Astro.url.origin).href
}
const account = {
  twitter: '@ibrahiminx'
}
---

<html lang="id">
	<head>
    <SEO
      charset='utf-8'
      title={meta.title}
      description={meta.description}
      openGraph={{
        basic: {
          title: meta.title,
          type: "website",
          image: meta.image,
        },
        optional: {
          description: meta.description
        }
      }}
      twitter={{
        card: 'summary_large_image',
        creator: account.twitter,
        title: meta.title,
        image: meta.image,
        description: meta.description
      }}
      {...seo}
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <slot name="meta" />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/favicon/apple-touch-icon.png`}>
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon/favicon-32x32.png`}>
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon/favicon-16x16.png`}>
    <link rel="manifest" href={`${base}/favicon/site.webmanifest`}>
    <link rel="sitemap" href={`${base}/sitemap-index.xml`}/>
	</head>
	<body class="bg-white min-h-screen flex flex-col justify-between">
    <div class="grow">
      {withNavbar && <nav class={`bg-white h-14 sm:h-16 border-b border-neutral-200 ${navbarSticky ? 'sticky top-0 left-0 z-10' : ''}`}>
        <BaseContainer class="h-full flex items-center justify-between gap-2 relative">
          <a href={base} class="flex items-center gap-2 text-accent font-bold hover:text-secondary">
            <Icon name="tabler:home-filled" class="shrink-0 size-5" />
            <span class="hidden sm:block">Beranda</span>
          </a>
          <slot name="nav-title" />
          <button class="sm:hidden" id="chapter-filter-mobile-button">
            <Icon name="tabler:search" class="shrink-0 size-5 text-accent" />
          </button>
          <div class="sm:flex items-center gap-2 hidden">
            <BaseSelect aria-label="Pilih Surah" id="chapter-select">
              <option selected disabled>Pilih Surah</option>
              {chapters.map(chapter => <option selected={Astro.url.pathname === `${base}/${chapter.data.slug}`} value={`${base}/${chapter.data.slug}`}>{chapter.id}. {chapter.data.latin}</link>)}
            </BaseSelect>
            {verseLength && <BaseSelect aria-label="Loncat ke Ayat" class="select-ayat">
              <option selected disabled>Ayat</option>
              {Array.from({ length: verseLength }, (_, i) => i + 1).map(verse => <option value={verse}>Ayat {verse}</link>)}
            </BaseSelect>}
          </div>
        </BaseContainer>
      </nav>}

      <slot /> 
    </div>

    <footer class="bg-background border-t border-neutral-200">
      <BaseContainer class="space-y-4 py-10">
        <div class="flex items-center justify-center gap-6">
          <a href={`${base}/about`} class="text-sm font-medium text-neutral-600 hover:text-accent">Tentang Website</a>
          <span class="text-neutral-300">|</span>
          <a href="http://github.com/ibrahimalanshor/quran" class="text-sm font-medium text-neutral-600 flex items-center gap-2 hover:text-accent">
            <Icon name="tabler:brand-github-filled" />
            Source Code
          </a>
        </div>
        <p class="text-sm text-neutral-400 text-center">&copy; 2025 - Al-Quran Online</p>
      </BaseContainer>
    </footer>

    <div class="hidden fixed inset-0 bg-black/50 z-10 flex items-center justify-center px-4 sm:hidden" id="chapter-filter-mobile-modal">
      <form class="bg-white p-6 rounded-lg w-full space-y-4" id="chapter-filter-mobile">
        <div class="flex flex-col gap-1">
          <label for="chapter-filter-mobile-select" class="text-neutral-700">Pilih Surah</label>
          <BaseSelect aria-label="Pilih Surah" id="chapter-filter-mobile-select" name="chapter" required>
            <option selected disabled>Pilih Surah</option>
            {chapters.map(chapter => <option data-verses={chapter.data.verses} selected={Astro.url.pathname === `${base}/${chapter.data.slug}`} value={`${base}/${chapter.data.slug}`}>{chapter.id}. {chapter.data.latin}</link>)}
          </BaseSelect>
        </div>
        <div class="flex flex-col gap-1">
          <label for="verse-filter-mobile-select" class="text-neutral-700">Pilih Ayat</label>
          <BaseSelect aria-label="Pilih Ayat" name="verse" id="verse-filter-mobile-select">
            <option selected disabled>Pilih Ayat</option>
            {Array.from({ length: verseLength }, (_, i) => i + 1).map(verse => <option value={verse}>Ayat {verse}</link>)}
          </BaseSelect>
        </div>
        <button class="bg-accent w-full text-white font-semibold rounded-md h-10">Baca</button>
      </form>
    </div>

    <script>
      const chapterSelect = document.getElementById('chapter-select')
      const chapterFilterMobileForm = document.getElementById('chapter-filter-mobile') as HTMLFormElement
      const chapterFilterMobileSelect = document.getElementById('chapter-filter-mobile-select') as HTMLSelectElement
      const verseFilterMobileSelect = document.getElementById('verse-filter-mobile-select') as HTMLSelectElement
      const chapterilterMobileButton = document.getElementById('chapter-filter-mobile-button') as HTMLButtonElement
      const chapterFilterMobileModal = document.getElementById('chapter-filter-mobile-modal') as HTMLDivElement

      chapterSelect?.addEventListener('change', e => {
        window.location.href = (e.target as HTMLSelectElement).value
      })

      document.querySelectorAll('.select-ayat')
        .forEach(select => {
          select.addEventListener('change', e => {
            const value = (e.target as HTMLSelectElement).value

            const ayatEl = document.getElementById(value)

            if (ayatEl) {
              ayatEl.scrollIntoView({ behavior: 'smooth' })
            }
          })
        })
      chapterFilterMobileForm.addEventListener('submit', e => {
        e.preventDefault()

        const value = new FormData(chapterFilterMobileForm)

        const verse = value.get('verse')

        if (verse) {
          window.location.href = `${value.get('chapter') as string}#${verse}`
        } else {
          window.location.href = value.get('chapter') as string
        }
      })
      chapterFilterMobileSelect.addEventListener('change', () => {
        const selectedOption = chapterFilterMobileSelect.querySelector(`option[value='${chapterFilterMobileSelect.value}']`) as HTMLOptionElement
        const verses = Number(selectedOption.dataset.verses)

        verseFilterMobileSelect.innerHTML = ''

        const fragment = document.createDocumentFragment()

        const option = document.createElement('option')
        option.setAttribute('selected', 'selected')
        option.setAttribute('disabled', 'disabled')

        option.textContent = `Pilih Ayat`

        fragment.appendChild(option)

        for (let i = 1; i <= verses; i++) {
          const option = document.createElement('option')
          option.value = `${i}`
          option.textContent = `Ayat ${i}`

          fragment.appendChild(option)
        }

        verseFilterMobileSelect.appendChild(fragment)        
      })
      chapterilterMobileButton.addEventListener('click', () => {
        chapterFilterMobileModal.classList.remove('hidden')
      })
      chapterFilterMobileModal.addEventListener('click', e => {
        if (!chapterFilterMobileForm.contains(e.target as Node)) {
          chapterFilterMobileModal.classList.add('hidden')
        }
      })
    </script>
	</body>
</html>
