---
import '@fontsource/inter';
import "../../styles/global.css"
import 'tippy.js/dist/tippy.css';
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import BaseContainer from '../base/BaseContainer.astro'
import BaseSelect from '../base/BaseSelect.astro'
import { SEO } from "astro-seo";

const base = import.meta.env.BASE_URL
const chapters = await getCollection('chapters')

const { title, description, seo, backUrl = base, withNavbar = true, navbarSticky = false, verseLength = null } = Astro.props

const meta = {
  title,
  description,
  image: new URL(base + '/banner.jpg', Astro.url.origin).href
}
const account = {
  twitter: '@ibrahiminx'
}
---

<html lang="id">
	<head>
    <SEO
      charset='utf-8'
      title={meta.title}
      description={meta.description}
      openGraph={{
        basic: {
          title: meta.title,
          type: "website",
          image: meta.image,
        },
        optional: {
          description: meta.description
        }
      }}
      twitter={{
        card: 'summary_large_image',
        creator: account.twitter,
        title: meta.title,
        image: meta.image,
        description: meta.description
      }}
      {...seo}
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <slot name="meta" />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/favicon/apple-touch-icon.png`}>
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon/favicon-32x32.png`}>
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon/favicon-16x16.png`}>
    <link rel="manifest" href={`${base}/favicon/site.webmanifest`}>
    <link rel="sitemap" href={`${base}/sitemap-index.xml`}/>
	</head>
	<body class="bg-gray-50 text-gray-800">
    {withNavbar && <nav class={`bg-white h-16 shadow-sm border-b border-gray-50 ${navbarSticky ? 'sticky top-0 left-0 z-10' : ''}`}>
      <BaseContainer class="h-full flex items-center justify-between gap-2">
        <a href={backUrl} class="flex items-center gap-2 text-emerald-600 font-bold hover:text-emerald-700">
          <Icon name="tabler:arrow-back-up" class="shrink-0 size-5" />
          <span class="hidden sm:block">Kembali</span>
        </a>
        <div class="flex items-center gap-2">
          <BaseSelect aria-label="Pilih Surah" id="chapter-select">
            <option selected disabled>Pilih Surah</option>
            {chapters.map(chapter => <option selected={Astro.url.pathname === `${base}/${chapter.data.slug}`} value={`${base}/${chapter.data.slug}`}>{chapter.id}. {chapter.data.latin}</link>)}
          </BaseSelect>
          {verseLength && <BaseSelect aria-label="Loncat ke Ayat" class="select-ayat">
            <option selected disabled>Ayat</option>
            {Array.from({ length: verseLength }, (_, i) => i + 1).map(verse => <option value={verse}>Ayat {verse}</link>)}
          </BaseSelect>}
        </div>
      </BaseContainer>
    </nav>}

    <slot /> 

    <BaseContainer tag="footer" class="space-y-4 py-10">
      <div class="flex items-center justify-center gap-6">
        <a href={`${base}/about`} class="text-sm font-medium text-gray-600 transition hover:text-emerald-600">Tentang Website</a>
        <span class="text-gray-300">|</span>
        <a href="http://github.com/ibrahimalanshor/quran" class="text-sm font-medium text-gray-600 flex items-center gap-2 transition hover:text-emerald-600">
          <Icon name="tabler:brand-github-filled" />
          Source Code
        </a>
      </div>
      <p class="text-sm text-gray-400 text-center">&copy; 2025 - Al-Quran Online</p>
    </BaseContainer>

    <script>
      const chapterSelect = document.getElementById('chapter-select')

      chapterSelect?.addEventListener('change', e => {
        window.location.href = (e.target as HTMLSelectElement).value
      })

      document.querySelectorAll('.select-ayat')
        .forEach(select => {
          select.addEventListener('change', e => {
            const value = (e.target as HTMLSelectElement).value

            const ayatEl = document.getElementById(value)

            if (ayatEl) {
              ayatEl.scrollIntoView({ behavior: 'smooth' })
            }
          })
        })
    </script>
	</body>
</html>
