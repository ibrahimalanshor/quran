---
import { getCollection, getEntry } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Default from '../../components/layouts/Default.astro'
import VerseRow from '../../components/verse/VerseRow.astro'
import BaseContainer from '../../components/base/BaseContainer.astro'
import BaseSelect from '../../components/base/BaseSelect.astro'
import BasePagination from '../../components/base/BasePagination.astro'

interface Props {
  chapter: CollectionEntry<'chapters'>
}

export async function getStaticPaths() {
  const chapters = await getCollection('chapters')

  return chapters.map(chapter => ({
    params: { slug: chapter.data.slug },
    props: { chapter }
  }))
}

const { chapter } = Astro.props
const verses = await getCollection('verses', verse => verse.data.chapter.id === chapter.id)
const prevChapter = chapter.id === '1' ? null : await getEntry('chapters', `${+chapter.id - 1}`)
const nextChapter = chapter.id === '144' ? null : await getEntry('chapters', `${+chapter.id + 1}`)
const bismillah = 'بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ'
---

<Default navbarSticky title={`Surah ${chapter.data.latin}: Arab dan Terjemahan`} verseLength={verses.length} description={`"Surah ${chapter.data.latin} adalah surah no ${chapter.id} dalam Al-Quran yang terdiri dari ${chapter.data.verses} ayat`}>
  <meta name="quran-chapter" content={chapter.data.latin} slot="meta" />

  <header class="py-10 bg-emerald-600 text-white">
    <BaseContainer class="text-center space-y-4">
      <div class="flex items-center justify-center gap-4">
        <span class="bg-emerald-500 text-white uppercase h-6 px-3 rounded-full inline-flex items-center justify-center text-xs font-bold tracking-widest">{chapter.data.type}</span>
        <span class="text-emerald-100">{chapter.data.translate}</span>
      </div>
      <h1 class="font-bold text-4xl">{chapter.data.latin}</h1>
      <p dir="rtl" class="text-4xl">{chapter.data.name}</p>
      <div class="flex items-center justify-center gap-4 text-emerald-100 text-sm">
        <span>Surah ke: {chapter.id}</span>
        <span class="w-1 h-1 rounded-full bg-emerald-100 inline-block"></span>
        <span>Jumlah ayat: {chapter.data.verses}</span>
      </div>
    </BaseContainer>
  </header>
  <BaseContainer tag="main" class="py-8 space-y-6">
    <article class="space-y-6">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <BaseSelect aria-label="Loncat ke Ayat" class="select-ayat w-full sm:w-auto">
          <option disabled selected>Loncat ke Ayat</option>
          {verses.map(verse => <option value={verse.data.verse}>Ayat {verse.data.verse}</option>)}
        </BaseSelect>
        {chapter.id !== '1' && chapter.id !== '9' && <div class="text-center md:text-right">
          <p dir="rtl" class="text-2xl leading-loose lg:text-3xl">{bismillah}</p>
        </div>}
      </div>
      {verses.map(verse => <VerseRow verse={verse} />)}
    </article>
    <BasePagination
      prevUrl={prevChapter ? prevChapter.data.slug : null}
      prevName={prevChapter ? prevChapter.data.latin : null}
      nextUrl={nextChapter ? nextChapter.data.slug : null}
      nextName={nextChapter ? nextChapter.data.latin : null}
    />
    <button id="go-up" class="fixed bottom-6 right-6 cursor-pointer transition bg-emerald-600 hover:bg-emerald-700 text-white w-12 h-12 rounded-full shadow-2xl flex items-center justify-center hidden focus:outline-0 focus:ring-4 focus:ring-emerald-400/30" title="Pergi ke Ayat Pertama">
      <Icon name="tabler:arrow-narrow-up" class="size-6" />
    </button>
  </BaseContainer>
</Default>

<script>
const firstVerse = document.getElementById('1') as HTMLDivElement
const goUpBtn = document.querySelector('#go-up') as HTMLButtonElement
const goUpObserver = new IntersectionObserver(([entry]) => entry.isIntersecting ? goUpBtn.classList.add('hidden') : goUpBtn.classList.remove('hidden'), { threshold: 0 })

goUpBtn.addEventListener('click', () => window.scroll({ top: 0, behavior: 'smooth' }))
goUpObserver.observe(firstVerse)
</script>
