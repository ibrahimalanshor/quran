---
import { getCollection, getEntry } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import Default from '../../components/layouts/Default.astro'
import BaseContainer from '../../components/base/BaseContainer.astro'
import BaseCard from '../../components/base/BaseCard.astro'
import VerseRow from '../../components/verse/VerseRow.astro'
import BasePagination from '../../components/base/BasePagination.astro'
import BaseLink from '../../components/base/BaseLink.astro'

interface Props {
  chapter: CollectionEntry<'chapters'>
  verse: CollectionEntry<'verses'>
}

export async function getStaticPaths() {
  const chapters = await getCollection('chapters') 
  const verses = await getCollection('verses')

  return verses.map(verse => {
    const chapter = chapters.find(chapter => chapter.id === verse.data.chapter.id) as CollectionEntry<'chapters'>

    return {
      params: {
        slug: chapter.data.slug,
        verse: verse.data.verse
      },
      props: { verse, chapter }
    }
  })
}

const { verse, chapter } = Astro.props
const tafsir = await getEntry('tafsir', verse.id)!
const prevVerse = verse.id === '1' ? null : await getEntry('verses', `${+verse.id - 1}`)
const nextVerse = verse.id === '6236' ? null : await getEntry('verses', `${+verse.id + 1}`)
const prevChapter = !prevVerse ? null : await getEntry('chapters', prevVerse.data.chapter.id)
const nextChapter = !nextVerse ? null : await getEntry('chapters', nextVerse.data.chapter.id)
---

<Default backUrl={`/${chapter.data.slug}`}>
  <meta name="quran-chapter" content={chapter.data.latin} slot="meta" />

  <BaseContainer tag="main" class="py-10 space-y-8">
    <header class="text-center">
      <p dir="rtl" class="text-emerald-600 text-5xl mb-8">{chapter.data.name}</p>
      <h1 class="font-bold text-3xl text-gray-900 mb-4">{chapter.data.latin}</h1>
      <p class="text-gray-500 text-lg mb-4">Ayat {verse.data.verse}</p>
      <hr class="w-16 h-1 bg-emerald-500 mx-auto rounded-full border-0">
    </header>
    <VerseRow verse={verse} withTafsirButton={false} />
    <BaseCard class="p-6 rounded-2xl space-y-4">
      <h2 class="font-bold text-xl text-gray-900">Tafsir Ringkas Kemenag</h2>
      <p class="leading-relaxed text-gray-700">{tafsir.data.text}</p>
      <div class="border-t border-gray-100 pt-4 flex gap-4 justify-end lg:justify-start">
        <BaseLink data-copy-content={`Tafsir QS. ${chapter.data.latin}: ${verse.data.verse}\n${tafsir.data.text}`} class="copy-tafser" icon="tabler:copy">
          Salin
        </BaseLink>
      </div>
    </BaseCard>
    <BasePagination
      prevUrl={prevVerse ? `${prevChapter!.data.slug}/${prevVerse.data.verse}` : null}
      prevName={prevVerse ? `${prevChapter!.data.latin}: ${prevVerse.data.verse}` : null}
      nextUrl={nextVerse ? `${nextChapter!.data.slug}/${nextVerse.data.verse}` : null}
      nextName={nextVerse ? `${nextChapter!.data.latin}: ${nextVerse.data.verse}` : null}
    />
  </BaseContainer>
</Default>

<script>
import tippy from 'tippy.js'

const copyBtn = tippy('.copy-tafser', {
  trigger: 'manual'
})

copyBtn.forEach(btn => {
  btn.reference.addEventListener('click', async () => {
    await navigator.clipboard.writeText((btn.reference as HTMLButtonElement).dataset.copyContent as string) 

    btn.setContent('Tafsir berhasil disalin')
    btn.show()
  })
})
</script>
