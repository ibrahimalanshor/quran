---
import { getCollection, getEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Default from '../../components/layouts/Default.astro'
import VerseRow from '../../components/verse/VerseRow.astro'
import BaseLink from '../../components/base/BaseLink.astro'

export async function getStaticPaths() {
    const chapters = await getCollection('chapters')

    return chapters.map(chapter => ({
        params: { slug: chapter.data.slug },
        props: { chapter }
    }))
}

const { chapter } = Astro.props
const verses = await getCollection('verses', verse => verse.data.chapter.id === chapter.id)
const prevChapter = chapter.id === '1' ? null : await getEntry('chapters', `${+chapter.id - 1}`)
const nextChapter = chapter.id === '144' ? null : await getEntry('chapters', `${+chapter.id + 1}`)
const bismillah = 'بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ'
---

<Default>
  <section class="text-center space-y-4 sm:flex sm:justify-between sm:items-center sm:text-left sm:space-y-0">
    <p dir="rtl" class="font-bold text-3xl text-green-700 sm:order-last lg:text-4xl">{chapter.data.name}</p>
    <div class="md:space-y-1 lg:space-y-2">
      <h1 class="font-bold text-lg sm:text-xl md:text-2xl lg:text-3xl">{chapter.data.latin}</h1>
      <p class="flex items-center justify-center gap-2 text-neutral-500">
        <span>Surah no. {chapter.id}</span>
        <span class="w-1 h-1 block bg-neutral-300 rounded-full"></span>
        <span>{chapter.data.type}</span>
        <span class="w-1 h-1 block bg-neutral-300 rounded-full"></span>
        <span>{chapter.data.verses} ayat</span>
      </p>
    </div>
  </section>
  <select id="select-ayat" class="w-full h-11 border-neutral-300 rounded-md focus:ring-2 focus:ring-green-600 focus:border-green-600 lg:w-auto lg:ml-auto">
    <option disabled selected>Pilih Ayat</option>
    {verses.map(verse => <option value={verse.data.verse}>{verse.data.verse}</option>)}
  </select>
  <article class="divide-y divide-neutral-300">
    {chapter.id !== '1' && chapter.id !== '9' && <div class="pt-2 pb-6 space-y-4 text-center">
      <p dir="rtl" class="text-2xl leading-loose lg:text-3xl">{bismillah}</p>
    </div>}
    {verses.map(verse => <VerseRow verse={verse} />)}
  </article>
  <nav class={`border-t border-neutral-300 py-6 flex items-center ${chapter.id === '1' ? 'justify-end' : 'justify-between'}`}>
    {prevChapter && <BaseLink href={`/chapters/${prevChapter.data.slug}`} class="flex items-center gap-2" color="primary">
      <Icon name="tabler:arrow-left" />
      {prevChapter.data.latin} 
    </BaseLink>}
    {nextChapter && <BaseLink href={`/chapters/${nextChapter.data.slug}`} class="flex items-center gap-2" color="primary">
      {nextChapter.data.latin} 
      <Icon name="tabler:arrow-right" />
    </BaseLink>}
  </nav>
</Default>

<script>
import tippy from 'tippy.js'

document.querySelector('#select-ayat')!
  .addEventListener('change', e => {
    const value = (e.target as HTMLSelectElement).value

    const ayatEl = document.getElementById(value)

    if (ayatEl) {
      ayatEl.scrollIntoView({ behavior: 'smooth' })

      history.pushState(null, '', `#${value}`)
    }
  })

const copyVersesBtn = tippy('.copy-verse', {
  trigger: 'manual'
})

const chapterName = document.querySelector('h1')!.textContent

copyVersesBtn.forEach(btn => {
  btn.reference.addEventListener('click', async () => {
    const verseNumber = (btn.reference as HTMLButtonElement).dataset.verseNumber as string
    const title = `Q.S ${chapterName}: ${verseNumber}`
    const text = document.getElementById(verseNumber)!
      .querySelector(`.verse-text`)!
      .textContent
    const translation = document.getElementById(verseNumber)!
      .querySelector(`.verse-translation`)!
      .textContent

    const content = `${title}\n${text}\n${translation}`

    await navigator.clipboard.writeText(content)

    btn.setContent('Ayat berhasil disalin!')
    btn.show()
  })
})
</script>
