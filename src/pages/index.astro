---
import { getCollection } from "astro:content";
import { Icon } from 'astro-icon/components'
import Default from '../components/layouts/Default.astro'
import BaseContainer from '../components/base/BaseContainer.astro'

const chapters = await getCollection('chapters')
---

<Default>
  <header class="bg-emerald-600 text-white h-52 flex flex-col items-center justify-center text-center shadow-lg">
    <div class="px-4 w-full space-y-6">
      <h1 class="font-bold text-4xl">Al-Quran Online</h1>
      <div class="max-w-lg mx-auto relative">
        <input type="search" placeholder="Cari nama surah" class="w-full h-12 px-5 rounded-full border-0 placeholder-gray-400 text-gray-700 shadow-md transition focus:outline-0 focus:ring-4 focus:ring-emerald-400" />
        <button id="search-btn" title="Cari nama surah" class="absolute top-1.5 right-2 bg-emerald-500 text-white h-9 w-9 flex items-center justify-center rounded-full cursor-pointer transition focus:outline-0 focus:ring-4 focus:ring-emerald-400/50">
          <Icon name="tabler:search" class="size-5" />
        </button>
      </div>
    </div>
  </header>

  <BaseContainer tag="main" class="py-10 space-y-6">
    <h2 class="font-semibold text-xl border-l-4 border-emerald-500 pl-3">Daftar Surah</h2>

    <p id="search-not-found-message" class="text-gray-400 hidden">Pencarian surah tidak ditemukan</p>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {chapters.map(chapter => <a href={`/chapters/${chapter.data.slug}`} data-chapter={chapter.data.latin} class="bg-white rounded-xl shadow-sm border border-gray-50 p-5 flex items-center justify-between trnsition hover:shadow-md hover:border-emerald-400 focus:outline-0 focus:shadow-md focus:border-emerald-400 group">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 flex items-center justify-center bg-emerald-50 font-bold text-emerald-600 rounded-lg transition group-hover:bg-emerald-600 group-hover:text-white group-focus:bg-emerald-600 group-focus:text-white">{chapter.id}</div>
          <div>
            <h3 class="font-bold">{chapter.data.latin}</h3>
            <p class="text-xs uppercase text-gray-500 tracking-wider">{chapter.data.verses} ayat</p>
          </div>
        </div>

        <p dir="rtl" class="text-emerald-700 text-2xl font-bold">{chapter.data.name}</p>
      </a>)}
    </div>
  </BaseContainer>
</Default>

<script>
  const searchInput = document.querySelector('input[type=search]') as HTMLInputElement
  const chapters = document.querySelectorAll('[data-chapter]')
  const searchNotFoundMsg = document.querySelector('#search-not-found-message') as HTMLParagraphElement
  const searchBtn = document.querySelector('#search-btn') as HTMLButtonElement

  searchInput.addEventListener('input', () => search())
  searchBtn.addEventListener('click', () => search())

  function search() {
    let found = false

    chapters.forEach(chapter => {
      if ((chapter as HTMLDivElement).dataset.chapter!.toLowerCase().includes(searchInput!.value.toLowerCase())) {
        chapter.classList.remove('hidden')

        found = true
      } else {
        chapter.classList.add('hidden')
      }
    }) 

    if (!found) {
      searchNotFoundMsg.classList.remove('hidden')
    } else {
      searchNotFoundMsg.classList.add('hidden')
    }
  }
</script>
