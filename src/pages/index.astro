---
import { getCollection } from "astro:content";
import { Icon } from 'astro-icon/components'
import Default from '../components/layouts/Default.astro'
import BaseContainer from '../components/base/BaseContainer.astro'

const base = import.meta.env.BASE_URL
const chapters = await getCollection('chapters')
---

<Default withNavbar={false} title="Al-Quran Online Terjemahan dan Tafsir Bahasa Indonesia" description="Baca Al-Quran Digital Online dengan terjemahan dan tafsir dalam Bahasa Indonesia Lengkap 30 Juz">
  <header class="bg-background text-neutral-900 border-b border-neutral-200 bg-[url(/quran/pattern.png)] bg-repeat-x">
    <BaseContainer class="w-full space-y-6 h-72 flex flex-col items-center justify-center text-center">
      <div class="space-y-3">
        <h1 class="font-bold text-4xl text-primary">Al-Quran Online</h1>
        <p class="text-neutral-600">Baca Al-Quran teks arab, latin, terjemah dan tafsir Bahasa Indonesia.</p>
      </div>
      <div class="w-full max-w-screen-sm mx-auto relative">
        <input type="text" id="search" placeholder="Cari nama surah" class="w-full border border-neutral-300 h-12 px-5 rounded-full placeholder-neutral-400 text-neutral-900 focus:outline-0 focus:ring-2 focus:ring-secondary focus:border-secondary" />
        <Icon name="tabler:search" class="size-5 absolute top-3.5 right-4 text-neutral-600" />
      </div>
    </BaseContainer>
  </header>

  <BaseContainer tag="main" class="py-10">
    <h2 class="font-semibold text-xl text-primary flex items-center gap-2">
      <Icon name="tabler:book-filled" class="text-accent" />
      Daftar Surah
    </h2>

    <div class="">
      <p id="search-not-found-message" class="text-neutral-500 hidden mt-6">Pencarian surah tidak ditemukan</p>

      <div class="mt-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 sm:gap-x-6 lg:gap-x-8">
        {chapters.map(chapter => <div data-chapter={chapter.data.latin} class="flex items-center justify-between py-5 border-b border-dashed border-neutral-300">
          <div class="space-y-1">
            <h3 class="font-bold text-primary hover:text-accent">
              <a href={`${base}/${chapter.data.slug}`}>{chapter.id}. {chapter.data.latin}</a>
            </h3>
          </div>

          <a href={`${base}/${chapter.data.slug}`} dir="rtl" class="text-secondary text-2xl font-bold hover:text-accent">{chapter.data.name}</a>
        </div>)}
      </div>
    </div>
  </BaseContainer>
</Default>

<script>
  const searchInput = document.querySelector('input#search') as HTMLInputElement
  const chapters = document.querySelectorAll('[data-chapter]')
  const searchNotFoundMsg = document.querySelector('#search-not-found-message') as HTMLParagraphElement

  searchInput.addEventListener('input', () => search())

  function search() {
    let found = false

    chapters.forEach(chapter => {
      if ((chapter as HTMLDivElement).dataset.chapter!.toLowerCase().includes(searchInput!.value.toLowerCase())) {
        chapter.classList.remove('hidden')

        found = true
      } else {
        chapter.classList.add('hidden')
      }
    }) 

    if (!found) {
      searchNotFoundMsg.classList.remove('hidden')
    } else {
      searchNotFoundMsg.classList.add('hidden')
    }
  }
</script>
