---
import '@fontsource/inter';
import "../styles/global.css"
import { getCollection } from "astro:content";

const chapters = await getCollection('chapters')
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body class="text-neutral-900">
    <main class="px-4 py-20 space-y-4 mx-auto sm:max-w-screen-sm md:max-w-screen-md lg:max-w-screen-lg">
      <h1 class="text-center font-bold text-2xl md:text-3xl xl:text-4xl">Baca Al-Quran Online</h1>
      <input type="search" placeholder="Cari nama surat" class="w-full rounded-md h-11 border-neutral-300 placeholder-neutral-400 focus:border-green-600 focus:ring-2 focus:ring-green-600" />
      <ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {chapters.map(chapter => <li data-chapter={chapter.data.latin} class="flex justify-between bg-neutral-100 rounded-md p-4 border border-neutral-300">
          <div>
            <div class="flex gap-1 font-semibold">
              <p>{chapter.id}.</p>
              <p>{chapter.data.latin}</p>
            </div>
            <p class="text-sm text-neutral-500 flex gap-2 items-center">
              {chapter.data.translate}
              <span class="w-1 h-1 bg-neutral-400 rounded-full"></span>
              {chapter.data.verses} ayat
            </p>
          </div>
          <p dir="rtl" class="text-xl font-bold self-center text-green-600">{chapter.data.name}</p>
        </li>)}
      </ol>
    </main>
	</body>

  <script>
    const searchInput = document.querySelector('main input')
    const chapters = document.querySelectorAll('[data-chapter]')

    searchInput?.addEventListener('input', e => {
      chapters.forEach(chapter => {
        if (chapter.dataset.chapter.toLowerCase().includes(e.target.value.toLowerCase())) {
          chapter.classList.remove('hidden')
        } else {
          chapter.classList.add('hidden')
        }
      }) 
    })
  </script>
</html> 
